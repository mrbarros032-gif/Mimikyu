# Mimikyu Environment Configuration Example
# Copy this file to .env or place corresponding values in local.properties

# Supabase TTML Lyrics CDN / Bucket
SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_LYRICS_BUCKET=lyrics
SUPABASE_LYRICS_BASE_URL=https://<your-project-id>.supabase.co/storage/v1/object/public/lyrics

# Optional Audiometa API key for extended metadata enrichment
AUDIOMETA_API_KEY=

# Android Release Signing (Optional - defaults to debug signing for local test builds)
RELEASE_STORE_FILE=../my-release-key.jks
RELEASE_STORE_PASSWORD=your_store_password
RELEASE_KEY_ALIAS=your_key_alias
RELEASE_KEY_PASSWORD=your_key_password
